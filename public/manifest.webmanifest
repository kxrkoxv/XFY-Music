{
  "id": "/",
  "name": "XFY",
  "short_name": "XFY",
  "description": "Reproductor musical moderno con letras, biblioteca y experiencia tipo app",
  "start_url": "/?source=pwa",
  "scope": "/",
  "display": "standalone",
  "display_override": ["window-controls-overlay", "standalone"],
  "orientation": "any",
  "background_color": "#06060a",
  "theme_color": "#06060a",
  "lang": "es",
  "dir": "ltr",
  "categories": ["music", "entertainment"],
  "icons": [
    {
      "src": "/icons/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icons/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icons/icon-maskable-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "/icons/icon-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "screenshots": [
    {
      "src": "/screenshots/narrow.png",
      "sizes": "540x960",
      "type": "image/png",
      "form_factor": "narrow",
      "label": "XFY en el teléfono — reproductor con letras karaoke"
    },
    {
      "src": "/screenshots/wide.png",
      "sizes": "1280x720",
      "type": "image/png",
      "form_factor": "wide",
      "label": "XFY en escritorio — biblioteca y descubrimiento"
    }
  ],
  "shortcuts": [
    {
      "name": "Descubrir música",
      "short_name": "Descubrir",
      "url": "/?source=shortcut#/discover",
      "icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192" }]
    },
    {
      "name": "Mis playlists",
      "short_name": "Playlists",
      "url": "/?source=shortcut#/playlists",
      "icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192" }]
    },
    {
      "name": "Ajustes",
      "short_name": "Ajustes",
      "url": "/?source=shortcut#/settings",
      "icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192" }]
    }
  ],
  "share_target": {
    "action": "/",
    "method": "GET",
    "enctype": "application/x-www-form-urlencoded",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url"
    }
  },
  "file_handlers": [
    {
      "action": "/",
      "accept": {
        "audio/mpeg": [".mp3"],
        "audio/mp4": [".m4a", ".mp4"],
        "audio/aac": [".aac"],
        "audio/ogg": [".ogg", ".opus"],
        "audio/wav": [".wav"],
        "audio/flac": [".flac"]
      }
    }
  ]
}
